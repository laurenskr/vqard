{
    "name": "qabana/statamic-vcard",
    "description": "Digital business cards with QR codes and .vcf download for Statamic.",
    "type": "statamic-addon",
    "license": "MIT",
    "authors": [
        {
            "name": "Qabana",
            "email": "laurens@qabana.nl"
        }
    ],
    "require": {
        "php": "^8.1",
        "statamic/cms": "^5.0 || ^6.0",
        "endroid/qr-code": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Qabana\\StatamicVcard\\": "src/"
        }
    },
    "extra": {
        "statamic": {
            "name": "vCard",
            "description": "Digital business cards with QR codes and .vcf download."
        },
        "laravel": {
            "providers": [
                "Qabana\\StatamicVcard\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}